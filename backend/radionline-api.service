[Unit]
Description=RadioNet PACS FastAPI
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/radionline/app
Environment=PYTHONPATH=/var/www/radionline/app
EnvironmentFile=/var/www/radionline/app/backend/.env
ExecStart=/var/www/radionline/app/backend/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
